{
  "name": "kinvoice-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "KinVoice web: register, teach KinVoice your voice and speech patterns, invite family, and check suspicious calls or voice notes. Front-end only; audio analysed in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "copy-guard": "node scripts/copy-guard.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/caprasimo": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
